{
  "name": "vite-plugin-runtime-css-injected",
  "version": "0.1.0",
  "description": "Vite build plugins: legacy import.meta.url shim (Rolldown) and runtime CSS injection",
  "type": "module",
  "license": "MIT",
  "author": "",
  "keywords": [
    "vite",
    "vite-plugin",
    "rolldown",
    "import-meta-url",
