{
  "name": "vue-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:all": "npm run build && npm run build:browser:all",
    "build:browser": "npm run build:browser:all",
    "build:browser:es": "vite build --config vite.browser.config.ts",
    "build:browser:legacy": "cross-env BROWSER_BUILD_TARGET=legacy vite build --config vite.browser.config.ts",
    "build:browser:all": "npm run build:browser:es && npm run build:browser:legacy",
    "build:browser:watch": "cross-env preview=4173 vite build --config vite.browser.config.ts --watch",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.51.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.37.0",
    "oxlint": "~1.51.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.2",
    "vite-plugin-vue-devtools": "^8.0.7",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}